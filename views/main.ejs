<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NBA Playoffs Stat Tracker</title>
  <script src="https://kit.fontawesome.com/24fe4e50ae.js" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>
  <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/themes/light.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&family=IBM+Plex+Sans+Condensed:wght@0,600;1,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="./styles/main.css">
</head>

<body>
  <div class="pageTitle">
    <img src="https://brandlogos.net/wp-content/uploads/2025/04/nba-logo_brandlogos.net_ipeky.png" alt="NBA logo" class="nbaLogo">
    <h1>Playoffs Stat Tracker - </h1>
    <img src="https://cdn-icons-png.flaticon.com/256/3177/3177043.png" alt="Larry O'Brien NBA championship trophy" class="trophy">
  </div>
  <div id="data"></div>

  <div class="flex-container">
    <% if (allPlayerStats) { %>
      <% allPlayerStats.forEach(player => { %>
        <div class="card">
          <img src=<%= player.image %> alt=<%= player.altText %> style="width:100%">
          <div class="card-container">
            <div class="logos-and-icons">
              <div class="team-logos">
                <img src=<%= player.logo %> alt="" >
              </div>
              <% if (player.eliminated === false) { %>
                <i class="fas fa-user-check fa-lg"></i>
              <% } else { %>
                <i class="fas fa-user-xmark fa-lg"></i>
              <% } %>
            </div>
            <h4><%= player.player %></h4>
            <p><b>Minutes: </b><%= player.minutes %></p>
            <p><b>Points: </b><%= player.points %></p>
            <p><b>Assists: </b><%= player.assists %></p>
            <p><b>Rebounds: </b><%= player.rebounds %></p>
            <p><b>FG %: </b><%= player.fgPercentage %></p>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
  <div class="icon-legend">
    <p><i class="fas fa-user-check fa-lg"></i><b> - Active </b></p>
    <p><i class="fas fa-user-xmark fa-lg"></i><b> - Eliminated </b></p>
  </div>
  <div class="repo-link">
    <a href="https://github.com/jmoten212/nba-playoff-stats-api" data-tippy-content="Link to GitHub Repository" data-tippy-placement="right-start"> 
      <img src="https://www.svgrepo.com/show/303548/git-icon-logo.svg" alt="Git icon" class="git-icon"/>
    </a>
  </div>

  <script>
    tippy('[data-tippy-content]');

    // fetch('/fetch-data')
    //   .then(res => res.json())
    //   .then(postseasonData => {
    //       document.getElementById('data').textContent = JSON.stringify(postseasonData, null, 2);
    //   })
    //   .catch(err => console.error(err));  
  </script>
</body>    

</html>
